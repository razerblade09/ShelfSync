DATABASE_URL=postgresql://library:library@localhost:5432/library
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# Server-side key used to verify signed tag payloads (dev only; rotate in prod)
TAG_SIGNING_KEY=change-me-dev-only
# Grace window before a missing copy is flagged UNACCOUNTED (hours) - value TBD, see docs/domain
UNACCOUNTED_GRACE_HOURS=24
